MANTIS_BASE_URL=https://your-mantis.domain.com
MANTIS_API_TOKEN=YOUR_API_TOKEN_HERE
MANTIS_RESOLVED_THRESHOLD=80
MANTIS_VECTOR_DB_PATH=.mantis-vector-store.json
# Optional: OpenAI-compatible embeddings API (if omitted, the local 256d vectorizer is used)
# MANTIS_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# MANTIS_ALLOW_EXTERNAL_EMBEDDINGS=true   # required opt-in: issue text is sent to the URL above
# MANTIS_EMBEDDING_API_KEY=sk-...
# MANTIS_EMBEDDING_MODEL=text-embedding-3-small

# Optional: block all write calls (POST/PATCH/PUT/DELETE); recommended if issue text is untrusted
# MANTIS_READ_ONLY=true
